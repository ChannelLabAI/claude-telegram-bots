{
  "method": "sqlite-verified-snapshot",
  "encryption": "aes-256-gcm",
  "encryption_key_env": "EVENT_LAYER_BACKUP_KEY",
  "retention": {
    "hourly_hours": 48,
    "daily_days": 30,
    "monthly_months": 12
  },
  "offsite": {
    "required": true,
    "target_uri_env": "EVENT_LAYER_OFFSITE_TARGET_URI",
    "credential_env": "EVENT_LAYER_OFFSITE_CREDENTIAL",
    "minimum_verified_copies": 1
  },
  "restore_access": "operator-only",
  "weekly_disposable_restore_required": true
}
