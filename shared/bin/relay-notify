#!/usr/bin/env bash
# Write one human-facing notification into the existing gateway relay queue.
set -euo pipefail

ROOT="${RELAY_NOTIFY_ROOT:-/home/oldrabbit/.claude-bots}"
RELAY_DIR="${RELAY_NOTIFY_DIR:-$ROOT/relay}"
TEAM_CONFIG="${RELAY_NOTIFY_TEAM_CONFIG:-$ROOT/shared/team-config.json}"
SOURCE="${1:-}"
RECIPIENT="${2:-}"
MESSAGE="${3:-}"

# 依 recipient 解析 TG username，供正文補 @mention；查不到回空字串。
# 為什麼需要：relay 有兩條消費路徑，判準不同——
#   pod 收件者   → relay-routing.ts findRelayBot：先比 recipient，比不中才 fallback 抓正文 @mention
#   常駐收件者   → server.patched.ts:719 processRelayDir：**只認正文 @username，完全不讀 recipient**
# relay-notify 原本原樣帶入 text，實測產出的信封不含任何 @（例：relay-notify pod-move anya "…"）。
# 收件者一旦轉常駐，pod-move / memocean-drift-check / boundary-0b-alert /
# stale_knowledge_check / backup-age-audit / dream_cycle 這幾條改道後的告警會全部變孤兒。
# 與 fatq-dispatch.sh 的 build_relay_json 採同一作法，保持兩個產生器行為一致。
# 「收件者是人」的別名 → 沒有任何 bot 叫 owner／laohu，所以這類告警**一則都送不到**。
# 2026-08-27 實查：recipient=owner/laohu 的 7 則，曾被任何人收過的是 0 則，
# 其中包含一則 8/24 標了 [ESCALATION] 的告警（七位特助 vault 權限失效，最久停 79 天），
# 躺了兩天才被人工翻出來。team-config 也沒有這種 state_dir，所以查表補 mention 救不了它們。
#
# 修法：同時 @ 兩個常駐（Diana 與 Anya）。processRelayDir 只檢查「正文含不含自己的
# username」，所以一則帶兩個 mention 的訊息，兩邊都會各自收到一份。
# **刻意做成兩個而不是一個**——如果只指定其中一位，那位掛掉時關於她掛掉的告警就送不出去，
# 那正是今晚討論過的循環依賴。兩個獨立 session、兩個獨立 token，任一個活著就送得出去。
OWNER_ALIASES_MENTIONS="@DianaAI_v2_bot @Anyachl_bot"
relay_notify_is_owner_alias() {
  case "$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')" in
    owner|laohu|oldrabbit|老兔) return 0 ;;
    *) return 1 ;;
  esac
}

relay_notify_mention_for() {
  local ident_lower
  ident_lower=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')
  if relay_notify_is_owner_alias "$ident_lower"; then
    printf '%s' "$OWNER_ALIASES_MENTIONS"
    return 0
  fi
  jq -r --arg ident "$ident_lower" '
    [ (.assistants // [])[]?,
      (.shared_pools // {} | to_entries[] | .value[]?) ]
    | map(select((.state_dir // "" | ascii_downcase) == $ident))
    | if length >= 1 then (.[0].bot_username // "") else "" end
  ' "$TEAM_CONFIG" 2>/dev/null
}

if [[ -z "$SOURCE" || -z "$RECIPIENT" || -z "$MESSAGE" ]]; then
  echo "relay-notify: usage: relay-notify <source> <recipient> <message>" >&2
  exit 2
fi
# SOURCE 允許冒號作為命名空間（例：dream_cycle:step6）；RECIPIENT 維持嚴格，
# 因為它要拿去比對 bot 名稱做路由，放寬會影響投遞語意。
#
# 2026-08-26 實證（c4d8 缺陷三）：dream_cycle.py:1888 與 :2123 分別傳
# source=dream_cycle:step6 與 dream_cycle:error，冒號不合原字元集 → exit 2，
# relay 檔根本產不出來。也就是說 dream cycle 的 100% 進度告警、以及「它自己
# 掛掉」的錯誤告警，兩者都發不出來，而且是靜默的。
# 這一關比 relay 寄件者白名單更早，所以補白名單救不了它。
if [[ ! "$SOURCE" =~ ^[A-Za-z0-9._:-]+$ ]]; then
  echo "relay-notify: source must match [A-Za-z0-9._:-]+ (got: $SOURCE)" >&2
  exit 2
fi
if [[ ! "$RECIPIENT" =~ ^[A-Za-z0-9._-]+$ ]]; then
  echo "relay-notify: recipient must be a stable bot identifier (got: $RECIPIENT)" >&2
  exit 2
fi

mkdir -p "$RELAY_DIR/.tmp"
tmp="$(mktemp "$RELAY_DIR/.tmp/relay-notify.XXXXXX")"
trap 'rm -f "$tmp"' EXIT
timestamp="$(TZ=Asia/Taipei date -Iseconds)"
# ⚠️ 2026-08-27 撤回 verbatim:true。曾短暫加上，但它建立在一個已被推翻的假設上，
# 而且實測**有害無益**：
#   gateway.ts:1158-1170 的 verbatim 分支，sendText 失敗時不丟例外，
#   接著的 renameSync（把檔案歸檔進 relay/read/）與 log("verbatim sent") 都**不在成功分支內**，
#   最後 continue，不會 fallback 到 enqueue。
#   結果：收件者若沒有 token（例如轉常駐後的 pod anya），告警送不出去卻被歸檔成「已處理」，
#   連 worker 的 exception 都不會留下。加這個欄位反而把「大聲失敗」換成「安靜消失」。
# 現場證據：relay/read/notify-verbatim-probe-c4d8.json 存在但無任何 .read-by 標記，
# 而 gateway log 同一毫秒內先印 sendMessage failed、後印 verbatim sent。
#
# 真正要修的是 gateway 那個「失敗仍歸檔」的行為，不是在產生端加旗標。
# 等那邊修好、且確認收件者有能力送出，再評估是否需要直送。
# owner 別名會回傳多個 mention（以空白分隔），一般 bot 回傳單一 username。
# 逐個檢查再補，已存在的不重複加。
_mentions="$(relay_notify_mention_for "$RECIPIENT")"
if [[ -n "$_mentions" ]]; then
  for _m in $_mentions; do
    _m="${_m#@}"
    [[ "$MESSAGE" == *"@${_m}"* ]] || MESSAGE="@${_m} ${MESSAGE}"
  done
fi
jq -n --arg from "$SOURCE" --arg recipient "$RECIPIENT" \
  --arg text "$MESSAGE" --arg ts "$timestamp" \
  '{from_bot:$from,recipient:$recipient,text:$text,message_id:0,ts:$ts}' > "$tmp"
filename="notify-${SOURCE}-$(date +%s%N 2>/dev/null || printf '%s' "$$").json"
mv "$tmp" "$RELAY_DIR/$filename"
trap - EXIT
printf '%s\n' "$RELAY_DIR/$filename"
